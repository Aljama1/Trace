rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ──────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }
    function isStaff() {
      return isAuth() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function isCliente() {
      return isAuth() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    // ─── Asignaciones de mesa por cliente ─────────────────────────────
    // El cliente, al hacer check-in, crea /asignaciones-mesa/{uid} con su
    // mesaId. Una vez creado NO puede modificarlo (las reglas lo impiden),
    // así el idMesa queda "anclado" server-side al uid del usuario. Esto
    // permite validar las comandas en el servidor (ver regla create de
    // /comandas más abajo) y cerrar el agujero de un cliente que cambie
    // mesaId manualmente desde DevTools.
    match /asignaciones-mesa/{uid} {
      allow read: if isStaff() || (isAuth() && request.auth.uid == uid);
      allow create: if isAuth()
                    && request.auth.uid == uid
                    && request.resource.data.idMesa is number
                    && request.resource.data.idMesa > 0;
      // El cliente no puede reasignarse mesa. Sólo staff puede liberar/cambiar
      // (por si hay que reubicar a un comensal manualmente).
      allow update, delete: if isStaff();
    }

    // ─── Comandas ─────────────────────────────────────────────────────
    // - Cliente anónimo: crea su propia comanda (idCliente == uid) y SOLO
    //   para la mesa que tiene asignada en /asignaciones-mesa/{uid}.
    //   Solo puede ACTUALIZAR mientras la comanda está en PENDIENTE y
    //   exclusivamente para añadir notas, o marcar solicitaCuenta=true.
    //   No puede tocar precio, estado, líneas críticas, reasignar la
    //   comanda a otra mesa/cliente, ni borrar.
    // - Staff (no anónimo): control total sobre las comandas.
    match /comandas/{comandaId} {
      allow create: if isStaff() || (
        isCliente()
        && request.resource.data.idCliente == request.auth.uid
        // El idMesa debe coincidir EXACTAMENTE con el asignado al uid.
        // idMesa se guarda como string en la comanda; en asignaciones-mesa
        // como number — string() los normaliza para comparar.
        && string(get(/databases/$(database)/documents/asignaciones-mesa/$(request.auth.uid)).data.idMesa) == request.resource.data.idMesa
      );

      allow read: if isStaff() || (
        isCliente() && resource.data.idCliente == request.auth.uid
      );

      allow update: if isStaff()
        // Cliente puede añadir notas en estado PENDIENTE sin tocar campos críticos
        || (isCliente()
            && resource.data.idCliente == request.auth.uid
            && resource.data.estado == 'PENDIENTE'
            && request.resource.data.idCliente == resource.data.idCliente
            && request.resource.data.idMesa == resource.data.idMesa
            && request.resource.data.estado == resource.data.estado
            && request.resource.data.precioTotal == resource.data.precioTotal
            && request.resource.data.lineasComanda == resource.data.lineasComanda)
        // Cliente puede marcar solicitaCuenta=true solo en comandas activas
        || (isCliente()
            && resource.data.idCliente == request.auth.uid
            && resource.data.estado != 'PAGADO'
            && resource.data.estado != 'CANCELADO'
            && request.resource.data.solicitaCuenta == true
            && request.resource.data.idCliente == resource.data.idCliente
            && request.resource.data.idMesa == resource.data.idMesa
            && request.resource.data.estado == resource.data.estado
            && request.resource.data.precioTotal == resource.data.precioTotal
            && request.resource.data.lineasComanda == resource.data.lineasComanda);

      allow delete: if isStaff();
    }

    // ─── Productos (carta) ────────────────────────────────────────────
    match /productos/{productoId} {
      allow read: if true;
      allow create, update, delete: if isStaff();
    }

    // ─── Facturas ─────────────────────────────────────────────────────
    // Solo staff. Append-only: una vez creada, la factura NO se puede
    // modificar ni borrar (integridad y trazabilidad histórica).
    match /facturas/{facturaId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if false;
    }

    // ─── Configuración ────────────────────────────────────────────────
    match /configuracion/{configId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // ─── Metadatos (contador correlativo inalterable) ───────────────────
    // Solo staff. La actualización está restringida a incrementos de +1
    // del contador, evitando que un admin malicioso rebobine la cadena.
    match /metadatos/{docId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update: if isStaff()
        && request.resource.data.ultimoNumero == resource.data.ultimoNumero + 1
        && request.resource.data.serieActual == resource.data.serieActual;
      allow delete: if false;
    }

    // ─── Default deny ─────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
